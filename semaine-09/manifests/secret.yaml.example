# Template (suit le même pattern que .env / terraform.tfvars.example / hosts.ini.example
# dans ce repo) : copier en secret.yaml (gitignored) et remplir les vraies valeurs,
# ou créer directement le Secret via `kubectl create secret generic ...`.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: devops-app
type: Opaque
stringData:
  POSTGRES_DB: devops
  POSTGRES_USER: yanis
  POSTGRES_PASSWORD: change-me
  DB_HOST: postgres
  DB_NAME: devops
  DB_USER: yanis
  DB_PASSWORD: change-me
